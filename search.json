[{% assign all = site.posts | concat: site.news | concat: site.portfolio %}{% for p in all %}{"title":{{ p.title | jsonify }},"url":{{ p.url | relative_url | jsonify }},"type":{{ p.collection | jsonify }},"text":{{ p.content | strip_html | strip_newlines | truncate: 400 | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
